# MCD AI 内容运营工作台环境变量示例
# 复制为 .env 后填入真实值；.env 不进 git

# ===== 应用模式 =====
# demo: 无外部 API 也能跑通完整流程（默认）
# internal_llm: 调用内网 LLM 网关
APP_MODE=demo

# ===== CTR 模式（独立于 APP_MODE） =====
# existing_predictor: 调用 mcd-ctr-predictor 真实预测
# baseline_only: 只返回历史基准
# demo: Demo 数据稳定占位
# unavailable: 不返回 CTR 结果
CTR_MODE=existing_predictor

# ===== LLM Provider（APP_MODE=internal_llm 时使用） =====
# 兼容 openai 协议的供应商：
#   openai / siliconflow / qianfan / MiniMax
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=

# ===== LLM 限速与超时 =====
LLM_TIMEOUT=60
LLM_BATCH_SLEEP=1.2

# ===== 旧项目路径（Adapter 调用时需要） =====
# 留空时使用相对路径；填绝对路径时方便独立部署
MCD_COPY_ANALYZER_PATH=
MCD_CTR_PREDICTOR_PATH=

# ===== 数据目录（默认 ./data） =====
DATA_DIR=./data

# ===== 端口（默认 8510；如与 mcd-copy-analyzer / mcd-ctr-predictor 冲突请改） =====
STREAMLIT_PORT=8510

# ===== 日志 =====
LOG_LEVEL=INFO
